# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Clerk (auto-injected by Clerk Vercel integration — add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY via the Vercel dashboard)
# See https://clerk.com/docs/deployments/overview

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron job secret — used to authenticate calls to /api/cron/turntimer.
# Set this to a long random string (e.g. openssl rand -hex 32).
# Configure the same value in your external cron service (cron-job.org) as the
# Authorization header: "Bearer <CRON_SECRET>"
CRON_SECRET=replace-with-a-long-random-secret

# Optional access password for gating the app
ACCESS_PASSWORD=
