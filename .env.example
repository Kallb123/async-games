# Each Vercel environment gets its own Clerk instance and its own MongoDB
# database — they're keyed to each other, since Mongo stores Clerk user IDs.
# See docs/environments.md before setting production up.

# MongoDB. The database name is the path in the URI (nothing in the app
# overrides it), so production and dev differ only by that last segment —
# e.g. /async-games-prod in production, /async-games everywhere else.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Clerk (auto-injected by Clerk Vercel integration — add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY via the Vercel dashboard)
# Production takes the pk_live_/sk_live_ keys of the production instance;
# preview and local keep the pk_test_/sk_test_ keys of the development one.
# See https://clerk.com/docs/deployments/overview

# Firebase Admin SDK. One Firebase project serves every environment — device
# tokens live in Clerk private metadata, so they split with the Clerk instance.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron job secret — used to authenticate calls to /api/cron/turntimer.
# Set this to a long random string (e.g. openssl rand -hex 32), a different one
# per environment. Configure the same value in your external cron service
# (cron-job.org) as the Authorization header: "Bearer <CRON_SECRET>"
CRON_SECRET=replace-with-a-long-random-secret

# Optional access password for gating the app
ACCESS_PASSWORD=

# Origin of this deployment, used to build the links opened when a push
# notification is tapped. Defaults to production if unset — override per
# environment (e.g. a staging deployment).
APP_URL=https://asyncgames.com
