{
  "name": "Async Games",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/async-games",

  // MONGODB_URI is set on the `app` service in docker-compose.yml so the app
  // points at the bundled Mongo instance. Clerk / Firebase keys are external
  // secrets — copy .env.example to .env.local and fill them in (postCreate
  // scaffolds the file for you).
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    // Persists your Claude login and settings across container rebuilds.
    // Without this you'd have to sign in every time you rebuild.
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js dev server",
      "onAutoForward": "notify"
    }
  },

  // Install dependencies and scaffold local env after the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mongodb.mongodb-vscode",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  // Run as the non-root user shipped with the base image.
  "remoteUser": "node"
}
